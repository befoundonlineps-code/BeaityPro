# dependencies
/node_modules

# next.js
/.next/
/out/
# the separate build dirs NEXT_BUILD_DIR points at, so a verification build
# cannot overwrite the .next a running dev server is serving from.
#
# 🔴 A PATTERN AND NOT A NAME, because the name was the hole. `/.next-check/`
# was listed by hand, then a probe run used `NEXT_BUILD_DIR=.next-probe` and
# `git add -A` swept eighteen build artefacts into a feature branch — the
# directory was deleted first, but the dev server was still alive and wrote it
# back between the delete and the add.
#
# ⚠️ A list of the build dirs we have thought of fails open: every new
# NEXT_BUILD_DIR value is a fresh hole, and nothing complains. The glob covers
# the ones nobody has invented yet.
/.next-*/

# production
/build

# env files
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*

# نسخُ البيّنة المضادّة — تُؤخذ قبل الحقن وتُحذف عند الإرجاع.
# وجودُها معناه حقنٌ قائمٌ الآن، و lib/counterEvidencePending.test.js بيسقّط عليه.
/.counter-evidence/
