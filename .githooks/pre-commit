#!/bin/sh
#
# يرفض الإيداع وهناك حقنُ بيّنةٍ مضادّةٍ قائمٌ في شجرة العمل.
#
# 🔴 السببُ سؤالٌ من المراجع، وكان في محلّه: حارسُ الحقن المنسيّ
# (lib/counterEvidencePending.test.js) لا يعمل إلّا حين تُشغَّل الحزمة. فمن
# يُودع بلا تشغيلها — وهو أمرٌ ممكن — يمرّ الحقنُ معه إلى التاريخ.
#
# ⚠️ ويفحص شيئًا واحدًا لا الحزمة كلّها، وذلك قرار: خطّافٌ يستغرق عشرين ثانية
# عند كلّ إيداع يُعلِّم صاحبَه أن يكتب `--no-verify`، فيصير الخطّافُ سببَ
# تعطيله. هذا الفحصُ وجودُ ملفّ — أجزاءٌ من الألف من الثانية — فلا شيء يدعو
# إلى تخطّيه.
#
# ⚠️ ويسكن `.githooks/` لا `hooks/`، وهذا تصحيحٌ لا ترتيب: `hooks/` مجلّدُ
# خطّافات React في هذا المستودع — ثلاثون ملفَّ `use*.js` — فسكربتُ صدفةٍ
# بينها يُقرأ غلطًا من الطرفين. والفصلُ يجعل «كلُّ ما في هذا المجلّد خطّافُ
# إيداع» جملةً صحيحةً بلا استثناء.
#
# ⚠️ وحدُّه يُقال بدل أن يُقرأ ضمانًا كاملًا:
#
#   ١. `core.hooksPath` إعدادٌ محلّيٌّ لا يُودَع مع المستودع. فكلُّ بيئةِ عملٍ
#      جديدة — نسخةٌ جديدة، جهازٌ آخر، مجلّدُ عملٍ موازٍ — تحتاج تشغيل
#      `npm run setup-hooks` مرّةً واحدةً بنفسها، وإلّا فالخطّافُ موجودٌ
#      وغيرُ موصول. **والخطوةُ الوحيدة المتبقّية التي تُتذكَّر.**
#      ✅ و`snapshot` يقرأ الإعداد فعلًا ويصرخ إن لم يكن موصولًا — أي عند
#      اللحظة التي يهمّ فيها بالضبط: لحظةَ أخذِ النسخة قبل الحقن.
#   ٢. `git commit --no-verify` يتخطّى كلّ خطّاف. لا شيء في git يمنع ذلك،
#      وقولُه أصدق من الصمت عنه.
#
# فالطبقات ثلاث ولا واحدة منها كاملة: هذا الخطّاف · حارسُ الحزمة · وصراخُ
# `snapshot`. وأيُّ واحدةٍ منها كافيةٌ وحدَها في الحالة الشائعة.
#
# ⚠️ **ولا يُقاس مسارُ السماح بإيداعِ تجربة.** الشرطُ تحت طرفاه `exit 1`
# و`exit 0`، فقياسُ الرفض يقيس الاثنين — والسماحُ هو غيابُ الرفض لا حالةٌ
# ثانية. وإيداعُ التجربة يُنشئ شيئًا يجب التراجعُ عنه بعدها، **والتراجعُ هو
# ما محا شغلًا غيرَ مُودَعٍ في هذا المستودع** (CLAUDE.md، البيّنة المضادّة).

if [ -f ".counter-evidence/manifest.json" ]; then
  echo ""
  echo "⛔ الإيداع مرفوض: في حقنُ بيّنةٍ مضادّةٍ قائمٌ الآن."
  echo ""
  node scripts/counter-evidence.mjs status 2>/dev/null || cat .counter-evidence/manifest.json
  echo ""
  echo "   للإرجاع:  node scripts/counter-evidence.mjs restore"
  echo ""
  exit 1
fi

exit 0
